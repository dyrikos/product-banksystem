{
  // Правила markdownlint: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // довгі рядки в таблицях і реченнях українською — норма
    "MD013": false,
    // однакові заголовки дозволені в різних розділах
    "MD024": { "siblings_only": true },
    // <br/> у Mermaid-блоках і таблицях
    "MD033": false,
    // стиль таблиць не нормуємо: компактні `|---|`
    "MD060": false
  },
  "ignores": ["build/**", "legacy/**"]
}
